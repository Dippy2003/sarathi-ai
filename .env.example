# OpenRouter (LLM: openai/gpt-oss-120b)
OPENROUTER_API_KEY=

# OpenAI (embeddings: text-embedding-3-small, optional Whisper API for STT)
OPENAI_API_KEY=

# Embedding provider: "local" (default, free, runs on-device via Chroma's
# built-in all-MiniLM-L6-v2, no API key needed) or "openai" (uses
# OPENAI_API_KEY + text-embedding-3-small, per the original tech stack).
EMBEDDING_PROVIDER=local

# TTS provider: "gtts" (default, free, no billing/API key needed) or
# "google_cloud" (uses GOOGLE_APPLICATION_CREDENTIALS + si-LK voice, per the
# original tech stack - requires a GCP project with billing enabled).
TTS_PROVIDER=gtts

# Google Cloud TTS (si-LK voice) - only needed if TTS_PROVIDER=google_cloud.
# Path to service account JSON.
GOOGLE_APPLICATION_CREDENTIALS=

# Chroma persistence directory
CHROMA_PERSIST_DIR=./chroma_db

# Optional: override the model used only for the Sinhala composer step.
# Defaults to google/gemini-2.5-flash (gpt-oss-120b produced degenerate/
# repetitive Sinhala output in testing). Leave unset to use that default.
# COMPOSER_MODEL=
