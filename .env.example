# OpenRouter (LLM: openai/gpt-oss-120b)
OPENROUTER_API_KEY=

# OpenAI (embeddings: text-embedding-3-small, optional Whisper API for STT)
OPENAI_API_KEY=

# Google Cloud TTS (si-LK voice) - path to service account JSON
GOOGLE_APPLICATION_CREDENTIALS=

# Chroma persistence directory
CHROMA_PERSIST_DIR=./chroma_db

# Optional: override the model used only for the Sinhala composer step, if
# gpt-oss-120b's Sinhala output quality is weak. Leave unset to use the
# default (openai/gpt-oss-120b, same as the rest of the pipeline).
# COMPOSER_MODEL=
